# Cloudflare Edge Configuration
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_TUNNEL_NAME=your_tunnel_name
CLOUDFLARE_TUNNEL_ID=your_tunnel_uuid_here

# Domain
APEX_DOMAIN=example.com

# Hardware MAC Addresses
MAC_PROXMOX_BUILTIN=00:00:00:00:00:00
MAC_PROXMOX_LEGACY=00:00:00:00:00:00
MAC_PROXMOX_USB=00:00:00:00:00:00
MAC_PROXMOX_WIFI=00:00:00:00:00:00
MAC_MAIN_PC=00:00:00:00:00:00
MAC_OPENWRT_VM=00:00:00:00:00:00
MAC_LXC_WAN_CONTROLLER=00:00:00:00:00:00
MAC_ESP32=00:00:00:00:00:00
MAC_ESP8266=00:00:00:00:00:00

# IoT Isolated Wi-Fi Configuration
WIFI_IOT_SSID=snowfox-iot
WIFI_IOT_KEY=your_strong_iot_psk_here

# Primary PPPoE Credentials (Physical Router / Mode 1)
PPPOE_PRIMARY_USER=your_primary_pppoe_username
PPPOE_PRIMARY_PASS=your_primary_pppoe_password

# Secondary PPPoE Credentials (OpenWrt VM / Standby or Dual WAN)
PPPOE_SECONDARY_USER=your_secondary_pppoe_username
PPPOE_SECONDARY_PASS=your_secondary_pppoe_password
