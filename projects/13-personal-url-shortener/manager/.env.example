# ==============================================================================
# Snowfox Short Links Manager Environment Configuration (vmbr1)
# ==============================================================================

# Port and binding host
PORT=8080
HOST=0.0.0.0

# Target Cloudflare Edge URL
CLOUDFLARE_WORKER_URL=https://short.snowfox.live

# Master Bearer Token (must match SHORTENER_SECRET_TOKEN in Cloudflare Worker)
# Generate with: openssl rand -hex 24
SHORTENER_SECRET_TOKEN=change_me_super_secret_token_123456
