[Unit]
Description=Snowfox Personal Short Links Manager (vmbr1)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/short-manager
EnvironmentFile=/opt/short-manager/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/short-manager/app.py
Restart=always
RestartSec=3
LimitNOFILE=65535

# Hardening
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
