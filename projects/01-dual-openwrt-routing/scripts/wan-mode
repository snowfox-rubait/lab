#!/bin/sh
# Multi-Mode WAN Controller for Dual OpenWrt & Shared ONU
# Usage: wan-mode [1|2|3|status]

MODE="$1"

case "$MODE" in
    1)
        echo "=== Switching to MODE 1 (Physical Router Main) ==="
        uci set network.wan.auto='1'
        uci commit network
        ifup wan
        ssh -y -i /root/.ssh/id_dropbear root@192.168.1.129 "ifdown wan_vlan" 2>/dev/null || true
        echo "Mode 1 active. Physical Router is dialing PPPoE."
        ;;
    2)
        echo "=== Switching to MODE 2 (OpenWrt VM Main) with 45s Watchdog ==="
        # Preserve golden known-good Mode 1 configuration if not already present
        if [ ! -f /etc/config/network.mode1.gold ]; then
            cp /etc/config/network /etc/config/network.mode1.gold
        fi
        cp /etc/config/network.mode1.gold /tmp/network.mode1.bak
        
        ifdown wan
        uci set network.wan.auto='0'
        uci commit network

        if ! ssh -y -i /root/.ssh/id_dropbear root@192.168.1.129 "ifup wan_vlan"; then
            echo "[Error] Failed to dispatch ifup wan_vlan to VM! Aborting Mode 2 switch."
            cp /tmp/network.mode1.bak /etc/config/network
            /etc/init.d/network reload
            ifup wan
            exit 1
        fi

        (
            echo "[Watchdog] Waiting 45s for OpenWrt VM to establish WAN session & routes..."
            sleep 45
            
            # 1. Verify VM WAN interface status
            VM_UP=$(ssh -y -i /root/.ssh/id_dropbear root@192.168.1.129 "ifstatus wan_vlan | grep -o '\"up\": true'" 2>/dev/null || echo "")
            # 2. Verify router's active default route uses VM gateway
            DEFAULT_VIA_VM=$(ip route | grep "default via 192.168.1.129" || true)
            # 3. Test end-to-end outbound ICMP reachability
            OUTBOUND_OK=""
            if ping -c 3 1.1.1.1 >/dev/null 2>&1; then
                OUTBOUND_OK="true"
            fi

            echo "[Watchdog] Check 1 (VM wan_vlan up): '$VM_UP'"
            echo "[Watchdog] Check 2 (Default via VM 192.168.1.129): '$DEFAULT_VIA_VM'"
            echo "[Watchdog] Check 3 (Outbound Ping 1.1.1.1): '$OUTBOUND_OK'"

            if [ -n "$VM_UP" ] && [ -n "$DEFAULT_VIA_VM" ] && [ -n "$OUTBOUND_OK" ]; then
                echo "[Watchdog] All 3 safety checks passed! Mode 2 switch successful."
                rm -f /tmp/network.mode1.bak
            else
                REASON=""
                [ -z "$VM_UP" ] && REASON="${REASON}[VM interface not up] "
                [ -z "$DEFAULT_VIA_VM" ] && REASON="${REASON}[Default route not via VM] "
                [ -z "$OUTBOUND_OK" ] && REASON="${REASON}[Outbound ping failed] "
                echo "[Watchdog] Safety validation failed: $REASON! Auto-reverting to Mode 1..."
                ssh -y -i /root/.ssh/id_dropbear root@192.168.1.129 "ifdown wan_vlan" 2>/dev/null || true
                cp /tmp/network.mode1.bak /etc/config/network
                /etc/init.d/network reload
                ifup wan
                echo "[Watchdog] Reverted to Mode 1 successfully."
            fi
        ) > /tmp/wan-mode-watchdog.log 2>&1 &
        
        echo "Mode 2 initiated. Watchdog active in background (log: /tmp/wan-mode-watchdog.log)."
        ;;
    3)
        echo "=== Switching to MODE 3 (Simultaneous Dual Active PPPoE) ==="
        uci set network.wan.auto='1'
        uci commit network
        ifup wan
        ssh -y -i /root/.ssh/id_dropbear root@192.168.1.129 "ifup wan_vlan" 2>/dev/null || true
        echo "Mode 3 active. Both routers dialing over shared ONU bridge."
        ;;
    status|"")
        echo "========================================"
        echo "           WAN STATUS & MODES           "
        echo "========================================"
        ROUTER_WAN=$(ifstatus wan | grep -o '"up": true' || echo "down")
        VM_WAN=$(ssh -y -i /root/.ssh/id_dropbear root@192.168.1.129 "ifstatus wan_vlan | grep -o '\"up\": true' || echo 'down'" 2>/dev/null)
        echo "Physical Router WAN (br-wan): $ROUTER_WAN"
        echo "OpenWrt VM WAN (VLAN 100):   $VM_WAN"
        echo "Active Default Route:"
        ip route | grep default
        echo "========================================"
        echo "Usage: wan-mode 1 (Physical Main)"
        echo "       wan-mode 2 (VM Main - with auto-revert)"
        echo "       wan-mode 3 (Dual Active PPPoE)"
        ;;
    *)
        echo "Unknown mode: $MODE"
        echo "Usage: wan-mode [1|2|3|status]"
        exit 1
        ;;
esac
